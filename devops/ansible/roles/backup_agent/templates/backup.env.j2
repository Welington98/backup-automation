# Gerado via Ansible (role backup_agent) - nao editar manualmente
RESTIC_PASSWORD="{{ backup_agent_env.RESTIC_PASSWORD }}"

BACKUP_TARGET_PATHS="{{ backup_agent_env.BACKUP_TARGET_PATHS }}"
BACKUP_TAG="{{ backup_agent_env.BACKUP_TAG }}"
EXCLUDE_FILE="{{ backup_agent_env.EXCLUDE_FILE }}"

REPO_LOCAL="{{ backup_agent_env.REPO_LOCAL }}"
KEEP_LOCAL_DAILY={{ backup_agent_env.KEEP_LOCAL_DAILY }}

ENABLE_CLOUD_SYNC="{{ backup_agent_env.ENABLE_CLOUD_SYNC }}"
REPO_CLOUD="{{ backup_agent_env.REPO_CLOUD }}"

AWS_ACCESS_KEY_ID="{{ backup_agent_env.AWS_ACCESS_KEY_ID }}"
AWS_SECRET_ACCESS_KEY="{{ backup_agent_env.AWS_SECRET_ACCESS_KEY }}"

KEEP_CLOUD_DAILY={{ backup_agent_env.KEEP_CLOUD_DAILY }}
KEEP_CLOUD_WEEKLY={{ backup_agent_env.KEEP_CLOUD_WEEKLY }}
KEEP_CLOUD_MONTHLY={{ backup_agent_env.KEEP_CLOUD_MONTHLY }}

CLIENT_NAME="{{ backup_agent_env.CLIENT_NAME }}"

ENABLE_ZABBIX="{{ backup_agent_env.ENABLE_ZABBIX }}"
ZABBIX_SERVER="{{ backup_agent_env.ZABBIX_SERVER }}"
ZABBIX_PORT={{ backup_agent_env.ZABBIX_PORT }}
ZABBIX_HOSTNAME="{{ backup_agent_env.ZABBIX_HOSTNAME }}"

ENABLE_ZABBIX_TLS="{{ backup_agent_env.ENABLE_ZABBIX_TLS }}"
ZABBIX_TLS_PSK_IDENTITY="{{ backup_agent_env.ZABBIX_TLS_PSK_IDENTITY }}"
ZABBIX_TLS_PSK_FILE="{{ backup_agent_env.ZABBIX_TLS_PSK_FILE }}"

# Cadastro automatico do host no Zabbix Server via API (opcional - em
# branco mantem o cadastro manual, ver docs/zabbix-monitoring.md).
ZABBIX_API_URL="{{ backup_agent_env.ZABBIX_API_URL | default('') }}"
ZABBIX_API_TOKEN="{{ backup_agent_env.ZABBIX_API_TOKEN | default('') }}"
