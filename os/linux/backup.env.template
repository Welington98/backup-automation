# ==============================================================================
# BACKUP AGENT - ENVIRONMENT CONFIGURATION (Fase 1: sem HashiCorp Vault)
# ==============================================================================

# Senha Mestre de Criptografia Restic (End-to-End)
RESTIC_PASSWORD="TROCAR_SENHA_MESTRE_CRIPTOGRAFIA"

# Diretorios a serem salvos (separados por virgula)
BACKUP_TARGET_PATHS="/var/univention-backup,/home,/etc"
BACKUP_TAG="ucs-daily"
EXCLUDE_FILE="/etc/backup-agent/excludes.txt"

# Repositorio Local (Stage 1)
REPO_LOCAL="/mnt/backup-local/restic-repo"
KEEP_LOCAL_DAILY=7

# Repositorio Nuvem (Stage 2)
ENABLE_CLOUD_SYNC="true"
REPO_CLOUD="s3:s3.amazonaws.com/seu-bucket-backups/CLIENTE-CODE/HOSTNAME"

# Credenciais S3 (AWS / Wasabi / Backblaze B2 / MinIO)
AWS_ACCESS_KEY_ID="SUA_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="SUA_SECRET_KEY"

# Retencao na Nuvem
KEEP_CLOUD_DAILY=7
KEEP_CLOUD_WEEKLY=4
KEEP_CLOUD_MONTHLY=12

# Nome do cliente/host group no Zabbix (ver docs/grafana-dashboards.md -
# usado como filtro "Cliente" no dashboard consolidado).
CLIENT_NAME="CLIENTE-CODE"

# Monitoramento Zabbix
ENABLE_ZABBIX="true"
ZABBIX_SERVER="zabbix.suaempresa.com"
ZABBIX_PORT="10051"
ZABBIX_HOSTNAME="HOSTNAME_EXATO_NO_ZABBIX"

# Criptografia do canal Zabbix via PSK (Pre-Shared Key) estatica
# Fase 1: sem HashiCorp Vault, sem rotacao automatica.
# Gere a PSK com: /usr/local/bin/backup-agent-generate-psk.sh
# e cadastre o mesmo valor em Data collection > Hosts > <host> > Encryption no Zabbix Server.
ENABLE_ZABBIX_TLS="true"
ZABBIX_TLS_PSK_IDENTITY="backup-agent:HOSTNAME_EXATO_NO_ZABBIX"
ZABBIX_TLS_PSK_FILE="/etc/backup-agent/certs/zabbix.psk"

# Cadastro automatico do host no Zabbix Server via API (opcional).
# Deixe em branco para manter o cadastro manual (ver docs/zabbix-monitoring.md).
# Token gerado em Administration > API tokens > Create no Zabbix Server.
ZABBIX_API_URL=""
ZABBIX_API_TOKEN=""
